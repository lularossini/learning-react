Host github.com-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_lu
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes

Host github.com-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
